[Unit]
Description=Ishtaria world server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ishtaria
Group=ishtaria
ExecStart=/usr/bin/ishtaria-server /etc/ishtaria/server.toml
Restart=on-failure
StateDirectory=ishtaria
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
